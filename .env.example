# Copy to .env.local and fill in real values there — .env.local is
# gitignored, this file is not. Never put real secrets in this file.

# Postgres connection string. Already provisioned for this project — reuses
# the same Supabase Postgres instance behind NEXT_PUBLIC_SUPABASE_URL rather
# than a second database, so pull the value Vercel already has for
# DATABASE_URL rather than creating a new one.
DATABASE_URL=

# CJ Dropshipping
CJ_API_EMAIL=
CJ_API_KEY=
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0

# The admin panel's login (lib/admin/auth.ts) — a separate NextAuth
# instance from the shopper-facing one, which already uses AUTH_SECRET /
# AUTH_URL (Auth.js v5 naming); this one deliberately uses the NEXTAUTH_*
# names instead so the two are never confused for each other.
#
# ADMIN_EMAIL / ADMIN_PASSWORD_HASH are only read by prisma/seed.ts, to
# create the first AdminUser row — not checked on every request (that's
# what NEXTAUTH_SECRET-signed sessions are for). ADMIN_PASSWORD_HASH is a
# bcrypt hash, not a plaintext password — generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Vercel Blob (admin panel's product image uploads) — provisioned from the
# Vercel dashboard (Storage tab -> Create Database -> Blob), which sets
# this automatically; no manual value needed here once that's done.
BLOB_READ_WRITE_TOKEN=

# Filled in once Skrill/Payoneer access exists (a later command) — the
# checkout flow doesn't call either of these yet.
SKRILL_MERCHANT_ID=
SKRILL_API_PASSWORD=
PAYONEER_API_KEY=
PAYONEER_API_SECRET=

WHATSAPP_SUPPORT_NUMBER=+994502996905
