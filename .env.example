# Copy to .env.local and fill in real values there — .env.local is
# gitignored, this file is not. Never put real secrets in this file.

# Postgres connection string. Already provisioned for this project — reuses
# the same Supabase Postgres instance behind NEXT_PUBLIC_SUPABASE_URL rather
# than a second database, so pull the value Vercel already has for
# DATABASE_URL rather than creating a new one.
DATABASE_URL=

# CJ Dropshipping
CJ_API_EMAIL=
CJ_API_KEY=
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0

# Minimal admin-route auth (HTTP Basic) until a real admin panel + login
# exists. ADMIN_PASSWORD_HASH is a bcrypt hash, not a plaintext password —
# generate one with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# For the admin panel's own NextAuth instance (a later command) — this
# project's shopper-facing auth already uses AUTH_SECRET/AUTH_URL (Auth.js
# v5 naming); confirm whether the admin panel reuses that or needs its own
# before wiring these in.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Filled in once Skrill/Payoneer access exists (a later command) — the
# checkout flow doesn't call either of these yet.
SKRILL_MERCHANT_ID=
SKRILL_API_PASSWORD=
PAYONEER_API_KEY=
PAYONEER_API_SECRET=

WHATSAPP_SUPPORT_NUMBER=+994502996905
