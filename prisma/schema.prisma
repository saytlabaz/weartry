// WearTry order management + CJ Dropshipping integration schema.
//
// Uses the Postgres database already provisioned for this project (the
// same instance behind NEXT_PUBLIC_SUPABASE_URL / DATABASE_URL in Vercel —
// Supabase's own Postgres, not a separate Vercel Postgres/Neon instance).
// Reusing it avoids splitting app data across two databases; the
// `next_auth` schema Supabase's NextAuth adapter owns is untouched — every
// model below lives in the default `public` schema.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  MEN
  WOMEN
  KIDS
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  AWAITING_TRANSFER
  TRANSFER_COMPLETE
  SENT_TO_CJ
  CJ_CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum AdminNotificationType {
  PAYMENT_PENDING_TRANSFER
  CJ_ORDER_FAILED
  LOW_STOCK
  GENERAL
}

enum SiteContentType {
  TEXT
  IMAGE_URL
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String
  category        ProductCategory
  price           Decimal         @db.Decimal(10, 2)
  compareAtPrice  Decimal?        @db.Decimal(10, 2)
  images          String[]
  sizes           String[]
  colors          String[]
  /** Fallback/summary stock — ProductVariant tracks it per color+size combo. */
  stock           Int             @default(0)
  /** CJ Dropshipping's product id for this item, once sourced from CJ. */
  cjProductId     String?
  isActive        Boolean         @default(true)
  /** Shown in the homepage's "Featured Products" section when true. */
  isFeatured      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  variants        ProductVariant[]
  reviews         ProductReview[]

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int
  comment      String
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int     @default(0)
  sku       String? @unique
  /** CJ Dropshipping's variant id (vid) for this color+size combo, once sourced from CJ. */
  cjVariantId String?

  @@unique([productId, color, size])
}

model Order {
  id                 String      @id @default(cuid())
  /** Human-readable, e.g. WT-2026-00001. */
  orderNumber        String      @unique
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingCountry    String
  /** Free-text, stored in the format CJ's createOrder call expects. */
  shippingProvince   String
  shippingCity       String
  shippingAddress    String
  shippingPostalCode String
  items              OrderItem[]
  subtotal           Decimal     @db.Decimal(10, 2)
  shippingCost       Decimal     @default(0) @db.Decimal(10, 2)
  total              Decimal     @db.Decimal(10, 2)
  currency           String      @default("USD")

  status OrderStatus @default(PENDING_PAYMENT)

  cjOrderId        String?
  cjConsigneeId    String?
  trackingNumber   String?
  trackingUrl      String?
  /** Skrill transaction id, once payment integration lands. */
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory OrderStatusLog[]
  notifications AdminNotification[]

  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /**
   * Not a relation to Product on purpose: the current storefront catalog
   * (lib/data.ts) is still static placeholder data, not Product rows, and
   * even once products move into the DB an order must survive the
   * referenced product being deleted later — productName/unitPrice below
   * are the snapshot that makes that safe either way.
   */
  productId     String
  productName   String
  variantColor  String?
  variantSize   String?
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/**
 * Backs the /faq page's questions, admin-editable via /idarepaneli/faq.
 * `locale` keeps the site's existing 25-language support intact, but the
 * admin panel only manages the "az" rows (it has no locale switcher — see
 * FaqPageView) — the public /faq page falls back to next-intl's message
 * files for every other locale, so those 24 languages are unaffected.
 */
model FaqItem {
  id        String   @id @default(cuid())
  locale    String   @default("en")
  category  String
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)

  @@index([locale, category])
}

/**
 * Key-value store for homepage/legal-page copy an admin can edit without a
 * deploy, via /idarepaneli/sehifeler. `locale` mirrors FaqItem's reasoning
 * — only "az" rows are admin-managed; every component reading from here
 * falls back to its next-intl translation when no row exists for the
 * current locale (untouched keys, or any non-"az" locale).
 */
model SiteContent {
  id        String           @id @default(cuid())
  key       String
  locale    String           @default("en")
  value     String
  type      SiteContentType  @default(TEXT)
  updatedAt DateTime         @updatedAt

  @@unique([key, locale])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/** A header/footer navigation link, managed at /idarepaneli/menyu. */
model NavItem {
  id        String    @id @default(cuid())
  label     String
  url       String
  /** Nullable — a top-level item when null, a submenu entry of `parentId` otherwise. */
  parentId  String?
  parent    NavItem?  @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavItem[] @relation("NavItemChildren")
  order     Int       @default(0)
  isActive  Boolean   @default(true)

  @@index([parentId])
}

/** A simple static content page (e.g. "About", "Campaigns"), rendered at /[locale]/[slug]. */
model CustomPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminNotification {
  id        String                @id @default(cuid())
  type      AdminNotificationType
  title     String
  message   String
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  isRead    Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([isRead])
  @@index([orderId])
}

/** Caches CJ Dropshipping's access token so it isn't re-requested on every call — it's valid 180 days. */
model CjApiToken {
  id        String   @id @default(cuid())
  token     String
  refreshToken String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}
